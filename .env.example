# تنظيم — انسخ إلى .env (على Serv00: ~/tanzeem/.env)
PORT=3000
HOST=127.0.0.1
# سلسلة عشوائية طويلة: توقيع رموز QR وتشفير الحقول الحساسة. لا تغيّرها بعد التشغيل.
APP_SECRET=
# مكان قاعدة البيانات (الافتراضي ./data)
# DATA_DIR=/usr/home/USER/tanzeem/data
# الرابط العام (للدعوات ورموز QR وعودة SSO)
PUBLIC_URL=http://localhost:3000
# بيانات تجريبية عند أول تشغيل على قاعدة فارغة (1 = نعم)
SEED_DEMO=1
# كلمة مرور حسابات الأدوار التجريبية (فارغة = لا تُنشأ)
DEMO_PASSWORD=
